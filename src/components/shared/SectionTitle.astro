---
interface Props {
    title: string;
    tag?: string;
}

const { title, tag } = Astro.props;
---

<header class="section-title">
    {tag && <p class="label-accent section-tag">{tag}</p>}
    <h2 class="title">{title}</h2>
    <slot />
</header>

<style>
    .section-title {
        margin-bottom: 4rem;
        max-width: 800px;
    }

    .section-tag {
        color: var(--color-accent);
        margin-bottom: 1rem;
    }

    .title {
        margin-bottom: 1rem;
    }
</style>
