---
interface Props {
    title: string;
    description: string;
    buttonText: string;
    buttonUrl: string;
}

const { title, description, buttonText, buttonUrl } = Astro.props;
---

<section class="cta-banner">
    <div class="container text-center">
        <h2 class="cta-title">{title}</h2>
        <p class="cta-description text-lg">{description}</p>
        <a href={buttonUrl} class="cta-button">
            {buttonText}
        </a>
    </div>
</section>

<style>
    .cta-banner {
        background-color: var(--color-accent);
        color: var(--color-white);
        padding-block: var(--section-padding);
        text-align: center;
    }

    .cta-title {
        color: var(--color-white);
        margin-bottom: 1.5rem;
    }

    .cta-description {
        margin-inline: auto;
        margin-bottom: 3rem;
    }

    .cta-button {
        display: inline-block;
        background-color: var(--color-white);
        color: var(--color-accent);
        padding: 1.25rem 2.5rem;
        font-family: var(--font-family-body);
        font-weight: var(--font-weight-medium);
        font-size: var(--text-lg);
        border-radius: 4px; /* subtle soft edge */
        transition:
            transform 0.3s ease,
            background-color 0.3s ease;
        text-decoration: none;
    }

    /* Hover effect for fine-pointer non-touch devices */
    @media (pointer: fine) {
        .cta-button:hover {
            transform: translateY(-4px);
            background-color: var(--color-bg);
        }
    }
</style>
