---
const stats = [
    { value: 10, suffix: "+", label: "Años de experiencia" },
    { value: 120, suffix: "+", label: "Hogares transformados" },
    { value: 100, suffix: "%", label: "Proyectos a medida" },
];
---

<section class="stats-section">
    <div class="container stats-grid">
        {
            stats.map((stat, i) => (
                <div class="stat-item">
                    <div class="stat-number font-heading">
                        <span class="counter" data-target={stat.value}>
                            0
                        </span>
                        {stat.suffix}
                    </div>
                    <div class="stat-label font-body font-light">
                        {stat.label}
                    </div>
                </div>
            ))
        }
    </div>
</section>

<script>
    import { gsap, ScrollTrigger } from "../../scripts/gsap-init";
    import { animateWithReducedMotion } from "../../scripts/gsap-init";

    document.addEventListener("astro:page-load", () => {
        const counters = document.querySelectorAll(
            ".counter",
        ) as NodeListOf<HTMLElement>;

        if (counters.length === 0) return;

        animateWithReducedMotion(() => {
            counters.forEach((counter) => {
                const target = parseInt(
                    counter.getAttribute("data-target") || "0",
                    10,
                );

                // Start at 0 explicitly
                counter.innerHTML = "0";

                ScrollTrigger.create({
                    trigger: counter,
                    start: "top 85%",
                    onEnter: () => {
                        gsap.to(counter, {
                            innerHTML: target,
                            duration: 2,
                            snap: { innerHTML: 1 },
                            ease: "power2.out",
                            // Force GSAP to treat innerHTML as a number string for snapping
                            onUpdate: function () {
                                counter.innerHTML = Math.round(
                                    Number(counter.innerHTML),
                                ).toString();
                            },
                        });
                    },
                    once: true,
                });
            });
        });
    });
</script>

<style>
    .stats-section {
        background-color: var(--color-dark-section);
        color: var(--color-white);
        padding-block: 4rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem 2rem;
        text-align: center;
    }

    @media (min-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .stat-number {
        color: var(--color-accent-light);
        font-size: var(--text-3xl);
        font-weight: var(--font-weight-bold);
        margin-bottom: 0.5rem;
        line-height: 1;
    }

    .stat-label {
        color: var(--color-surface);
        font-size: var(--text-sm);
    }
</style>
