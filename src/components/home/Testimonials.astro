---
import SectionTitle from "../shared/SectionTitle.astro";

const testimonials = [
    {
        quote: "Entendieron perfectamente lo que necesitábamos. Más que decorar nuestra casa, le dieron alma. Cada vez que entramos por la puerta, sentimos paz.",
        name: "Marta y Javier",
        info: "Madrid · Interiorismo Completo",
    },
    {
        quote: "La consultoría online fue un antes y un después. Estábamos atascados con el salón y en solo una sesión nos dieron la claridad y la visión que faltaba.",
        name: "Lucía P.",
        info: "Barcelona · Consultoría Online",
    },
    {
        quote: "Una sensibilidad exquisita para los materiales y la luz. Trabajar con el estudio fue fácil, transparente y el resultado superó nuestras expectativas.",
        name: "Familia Gómez",
        info: "Valencia · Proyecto Residencial",
    },
];
---

<section class="testimonials-section">
    <div class="container relative">
        <SectionTitle
            title="Lo que dicen nuestras clientas"
            tag="Testimonios"
        />

        <div class="carousel-container relative">
            <div
                class="carousel-track flex"
                role="region"
                aria-label="Testimonios de clientes"
                aria-live="polite"
                id="testimonials-track"
            >
                {
                    testimonials.map((t, idx) => (
                        <div
                            class="carousel-slide w-full flex-shrink-0"
                            role="group"
                            aria-roledescription="slide"
                            aria-label={`${idx + 1} de ${testimonials.length}`}
                        >
                            <div class="testimonial-card">
                                <div
                                    class="stars mb-6 text-accent"
                                    aria-hidden="true"
                                >
                                    {Array.from({ length: 5 }).map(() => (
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                            class="inline-block mr-1"
                                        >
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                        </svg>
                                    ))}
                                </div>
                                <blockquote class="testimonial-quote font-heading italic text-2xl lg:text-3xl">
                                    "{t.quote}"
                                </blockquote>
                                <div class="testimonial-author mt-8">
                                    <p class="font-heading font-bold text-lg">
                                        {t.name}
                                    </p>
                                    <p class="font-accent text-sm text-ink-muted tracking-widest uppercase mt-1">
                                        {t.info}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Controls -->
            <div
                class="carousel-controls mt-12 flex justify-between items-center max-w-sm mx-auto"
            >
                <button
                    class="nav-btn prev-btn bg-surface p-3 rounded-full hover:bg-surface-deep transition-colors"
                    aria-controls="testimonials-track"
                    aria-label="Testimonio anterior"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                    >
                        <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                </button>

                <div
                    class="carousel-dots flex gap-2"
                    role="tablist"
                    aria-label="Elegir testimonio"
                >
                    {
                        testimonials.map((_, idx) => (
                            <button
                                class={`dot w-3 h-3 rounded-full transition-colors ${idx === 0 ? "bg-accent" : "bg-surface-deep"}`}
                                role="tab"
                                aria-selected={idx === 0 ? "true" : "false"}
                                aria-label={`Ir al testimonio ${idx + 1}`}
                                data-index={idx}
                            />
                        ))
                    }
                </div>

                <button
                    class="nav-btn next-btn bg-surface p-3 rounded-full hover:bg-surface-deep transition-colors"
                    aria-controls="testimonials-track"
                    aria-label="Siguiente testimonio"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                    >
                        <path d="M9 18l6-6-6-6"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const track = document.getElementById("testimonials-track");
        if (!track) return;

        const container = track.closest(".carousel-container");
        if (!container) return;

        const slides = Array.from(
            track.querySelectorAll(".carousel-slide"),
        ) as HTMLElement[];
        const dots = Array.from(
            container.querySelectorAll(".dot"),
        ) as HTMLButtonElement[];
        const prevBtn = container.querySelector(
            ".prev-btn",
        ) as HTMLButtonElement;
        const nextBtn = container.querySelector(
            ".next-btn",
        ) as HTMLButtonElement;

        let currentIndex = 0;

        const goTo = (index: number) => {
            if (index < 0) index = slides.length - 1;
            if (index >= slides.length) index = 0;
            currentIndex = index;

            track.style.transform = `translateX(-${currentIndex * 100}%)`;

            dots.forEach((dot, i) => {
                const active = i === currentIndex;
                dot.setAttribute("aria-selected", active.toString());
                dot.classList.toggle("bg-accent", active);
                dot.classList.toggle("bg-surface-deep", !active);
            });
        };

        prevBtn?.addEventListener("click", () => goTo(currentIndex - 1));
        nextBtn?.addEventListener("click", () => goTo(currentIndex + 1));
        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                goTo(parseInt(dot.getAttribute("data-index") || "0", 10));
            });
        });
    });
</script>

<style>
    .testimonials-section {
        padding-block: var(--section-padding);
        background-color: var(--color-surface);
        width: 100%;
        overflow: hidden;
    }

    .carousel-track {
        display: flex;
        transition: transform 0.5s ease;
        will-change: transform;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-slide {
        width: 100%;
        flex-shrink: 0;
        padding-inline: 1rem;
    }

    /* Utility classes mapped to inline styles for non-Tailwind setup */
    .relative {
        position: relative;
    }
    .flex {
        display: flex;
    }
    .w-full {
        width: 100%;
    }
    .flex-shrink-0 {
        flex-shrink: 0;
    }
    .inline-block {
        display: inline-block;
    }
    .mr-1 {
        margin-right: 0.25rem;
    }
    .mb-6 {
        margin-bottom: 1.5rem;
    }
    .mt-8 {
        margin-top: 2rem;
    }
    .mt-1 {
        margin-top: 0.25rem;
    }
    .mt-12 {
        margin-top: 3rem;
    }
    .justify-between {
        justify-content: space-between;
    }
    .items-center {
        align-items: center;
    }
    .max-w-sm {
        max-width: 24rem;
    }
    .mx-auto {
        margin-inline: auto;
    }
    .gap-2 {
        gap: 0.5rem;
    }
    .p-3 {
        padding: 0.75rem;
    }
    .rounded-full {
        border-radius: 9999px;
    }
    .transition-colors {
        transition-property:
            background-color, border-color, color, fill, stroke;
        transition-duration: 300ms;
    }
    .bg-surface {
        background-color: var(--color-surface);
    }
    .bg-surface-deep {
        background-color: var(--color-surface-deep);
    }
    .bg-accent {
        background-color: var(--color-accent);
    }
    .hover\:bg-surface-deep:hover {
        background-color: var(--color-surface-deep);
    }
    .w-3 {
        width: 0.75rem;
    }
    .h-3 {
        height: 0.75rem;
    }

    .testimonial-card {
        max-width: 800px;
        margin-inline: auto;
        text-align: center;
    }

    .testimonial-quote {
        color: var(--color-ink);
        line-height: 1.4;
    }

    .testimonial-author {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .text-2xl {
        font-size: var(--text-2xl);
    }
    @media (min-width: 1024px) {
        .lg\:text-3xl {
            font-size: var(--text-3xl);
        }
    }

    .tracking-widest {
        letter-spacing: 0.1em;
    }
    .uppercase {
        text-transform: uppercase;
    }
</style>
