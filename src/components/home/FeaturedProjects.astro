---
import { projects } from "../../data/projects";
import ProjectCard from "../shared/ProjectCard.astro";
import SectionTitle from "../shared/SectionTitle.astro";

// Obtener los 3 proyectos más recientes (simplificado, cogemos los primeros 3)
const featuredProjects = projects.slice(0, 3);
---

<section class="featured-projects">
    <div class="container">
        <div class="header-content reveal-on-scroll">
            <SectionTitle
                tag="Proyectos recientes"
                title="Hogares que hemos creado"
            />
        </div>

        <div class="projects-grid">
            {
                featuredProjects.map((project, index) => (
                    <ProjectCard
                        project={project}
                        class={`project-item reveal-on-scroll item-${index + 1}`}
                    />
                ))
            }
        </div>

        <div class="text-center mt-12 reveal-on-scroll">
            <a
                href="/proyectos"
                class="link-explore font-body text-accent font-medium"
            >
                Explorar todos los proyectos &rarr;
            </a>
        </div>
    </div>
</section>

<script>
    import { gsap, ScrollTrigger } from "../../scripts/gsap-init";
    import { animateWithReducedMotion } from "../../scripts/gsap-init";

    document.addEventListener("astro:page-load", () => {
        animateWithReducedMotion(() => {
            const reveals = document.querySelectorAll(
                ".featured-projects .reveal-on-scroll",
            );

            reveals.forEach((el, index) => {
                gsap.fromTo(
                    el,
                    { y: 70, opacity: 0 },
                    {
                        y: 0,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: el,
                            start: "top 85%",
                            // Stagger on grid items if needed, but simple reveal works fine and is safer across viewports
                            once: true,
                        },
                    },
                );
            });
        });
    });
</script>

<style>
    .featured-projects {
        padding-block: var(--section-padding);
        background-color: var(--color-bg);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 1024px) {
        .projects-grid {
            grid-template-columns: 2fr 1.5fr;
            grid-template-rows: repeat(2, 1fr);
            height: 800px;
        }

        .projects-grid :global(.item-1) {
            grid-row: span 2;
            height: 100%;
        }

        .projects-grid :global(.item-2),
        .projects-grid :global(.item-3) {
            grid-column: 2;
            height: calc(400px - 1rem); /* Half height minus half gap */
        }
    }

    .link-explore {
        display: inline-block;
        position: relative;
        padding-bottom: 0.25rem;
        text-decoration: none;
        transition: color 0.3s;
    }

    .link-explore::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0%;
        height: 1px;
        background-color: var(--color-accent);
        transition: width 0.3s ease;
    }

    @media (pointer: fine) {
        .link-explore:hover::after {
            width: 100%;
        }

        .link-explore:hover {
            color: var(--color-accent-light);
        }
    }
</style>
