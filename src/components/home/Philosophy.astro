---
// Component for the Manifesto/Philosophy section
---

<section class="philosophy-section">
    <div class="parallax-wrapper">
        <div
            class="parallax-bg"
            style="background-image: url('https://images.unsplash.com/photo-1600585154526-990dced4db0d?w=1800&q=90&fit=crop');"
        >
        </div>
        <div class="overlay"></div>
    </div>

    <div class="container content">
        <blockquote class="manifesto-quote font-heading italic">
            "Un buen diseño no impresiona.<br class="hidden-md-down" /> Te hace sentir
            en casa."
        </blockquote>
        <p class="manifesto-author font-body text-sm font-light">
            — Elena Vidal, Fundadora de Raíz Estudio
        </p>
        <a href="/estudio" class="cta-link label-accent">
            Conoce nuestra historia &rarr;
        </a>
    </div>
</section>

<script>
    import { gsap, ScrollTrigger } from "../../scripts/gsap-init";
    import { animateWithReducedMotion } from "../../scripts/gsap-init";

    document.addEventListener("astro:page-load", () => {
        animateWithReducedMotion(() => {
            const bg = document.querySelector(".parallax-bg");
            if (bg) {
                gsap.to(bg, {
                    yPercent: -15, // Moves up as we scroll down
                    ease: "none",
                    scrollTrigger: {
                        trigger: ".philosophy-section",
                        start: "top bottom",
                        end: "bottom top",
                        scrub: true,
                    },
                });
            }

            // Simple fade up for content
            gsap.fromTo(
                ".manifesto-quote, .manifesto-author, .cta-link",
                { opacity: 0, y: 30 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.2,
                    scrollTrigger: {
                        trigger: ".philosophy-section",
                        start: "top 70%",
                        once: true,
                    },
                },
            );
        });
    });
</script>

<style>
    .philosophy-section {
        position: relative;
        height: 100vh;
        height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        text-align: center;
    }

    .parallax-wrapper {
        position: absolute;
        inset: 0;
        z-index: 1;
        overflow: hidden;
    }

    /* Increase scale so when it translates Y it doesn't show edges */
    .parallax-bg {
        position: absolute;
        top: -15%;
        left: 0;
        width: 100%;
        height: 130%;
        background-size: cover;
        background-position: center;
        will-change: transform;
    }

    .overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(30, 23, 16, 0.55);
    }

    .content {
        position: relative;
        z-index: 2;
        color: var(--color-white);
        max-width: 800px;
        padding: var(--container-padding);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .manifesto-quote {
        font-size: var(--text-3xl);
        line-height: 1.2;
        margin: 0 0 2rem 0;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.2);
    }

    .manifesto-author {
        margin-bottom: 4rem;
        color: var(--color-surface);
        letter-spacing: 0.05em;
    }

    .cta-link {
        display: inline-block;
        color: var(--color-white);
        text-decoration: none;
        border: 1px solid var(--color-white);
        padding: 1rem 2rem;
        transition: all 0.3s ease;
    }

    @media (pointer: fine) {
        .cta-link:hover {
            background-color: var(--color-white);
            color: var(--color-ink);
        }
    }

    html:not(.no-js) .manifesto-quote,
    html:not(.no-js) .manifesto-author,
    html:not(.no-js) .cta-link {
        opacity: 0;
    }
</style>
