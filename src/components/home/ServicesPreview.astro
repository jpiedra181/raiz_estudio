---
import SectionTitle from "../shared/SectionTitle.astro";

const services = [
    {
        title: "Interiorismo Residencial",
        description:
            "Transformamos tu casa de principio a fin, creando un espacio cohesivo y pensado exclusivamente para ti. Nos encargamos de todo el proceso para que tú solo disfrutes.",
        url: "/servicios",
        iconPath: "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 22V12h6v10",
    },
    {
        title: "Consultoría Online",
        description:
            "Orientación profesional a distancia. Resolvemos tus dudas de diseño, colores o distribución a través de videollamadas, estés donde estés.",
        url: "/consultoria-online",
        iconPath:
            "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z",
    },
];
---

<section class="services-preview-section">
    <div class="container">
        <div class="services-header service-reveal">
            <SectionTitle title="¿Cómo podemos ayudarte?" tag="Servicios" />
        </div>

        <div class="services-grid">
            {
                services.map(({ title, description, url, iconPath }) => (
                    <a href={url} class="service-card service-reveal">
                        <div class="icon-wrapper">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                class="service-icon"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d={iconPath} />
                            </svg>
                        </div>
                        <h3 class="font-heading service-title">{title}</h3>
                        <p class="font-body font-light service-description">
                            {description}
                        </p>
                        <span class="service-link font-accent">
                            Saber más &rarr;
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { gsap, ScrollTrigger } from "../../scripts/gsap-init";
    import { animateWithReducedMotion } from "../../scripts/gsap-init";

    document.addEventListener("astro:page-load", () => {
        animateWithReducedMotion(() => {
            const triggers = document.querySelectorAll(".service-reveal");

            triggers.forEach((trigger, index) => {
                gsap.fromTo(
                    trigger,
                    { opacity: 0, y: 50 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: index * 0.15, // Simple stagger using index
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: trigger,
                            start: "top 85%",
                            once: true,
                        },
                    },
                );
            });
        });
    });
</script>

<style>
    .services-preview-section {
        padding-block: var(--section-padding);
        background-color: var(--color-surface);
    }

    .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .services-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .service-card {
        display: block;
        background-color: var(--color-bg);
        border: 1px solid var(--color-surface-deep);
        padding: clamp(2rem, 5vw, 4rem);
        text-decoration: none;
        color: var(--color-ink);
        border-radius: 2px;
        transition:
            transform 0.4s ease,
            box-shadow 0.4s ease,
            border-color 0.4s ease;
    }

    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(30, 23, 16, 0.08);
        border-color: var(--color-accent-light);
    }

    .icon-wrapper {
        margin-bottom: 2rem;
        color: var(--color-accent);
    }

    .service-icon {
        width: 48px;
        height: 48px;
    }

    .service-title {
        font-size: var(--text-2xl);
        margin-bottom: 1rem;
        line-height: 1.2;
        transition: color 0.3s;
    }

    .service-card:hover .service-title {
        color: var(--color-accent);
    }

    .service-description {
        color: var(--color-ink-muted);
        margin-bottom: 2rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .service-link {
        display: inline-block;
        color: var(--color-accent);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-medium);
    }

    /* Pre-animation states */
    html:not(.no-js) .service-reveal {
        opacity: 0;
    }
</style>
