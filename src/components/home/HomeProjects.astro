---
import Chapter from "../ui/Chapter.astro";
import Button from "../ui/Button.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { featuredProjects, projects } from "../../data/projects";

const layout = [
    { ratio: "5 / 4", sizes: "(min-width: 900px) 56vw, 100vw" },
    { ratio: "4 / 5", sizes: "(min-width: 900px) 31vw, 100vw" },
    { ratio: "4 / 5", sizes: "(min-width: 900px) 31vw, 100vw" },
    { ratio: "5 / 4", sizes: "(min-width: 900px) 48vw, 100vw" },
];
---

<section class="home-projects section" aria-labelledby="projects-title">
    <div class="wrap">
        <header class="home-projects__head">
            <Chapter num="02" label="Proyectos" />
            <h2 id="projects-title" class="t-h1" data-split>Hogares <em>con raíz</em></h2>
            <div class="home-projects__intro">
                <p class="t-soft" data-reveal>
                    Cada casa cuenta una historia distinta. Estas son algunas de las que hemos tenido el privilegio de
                    escribir junto a sus dueños.
                </p>
                <div data-reveal>
                    <Button href="/proyectos">Ver los {projects.length} proyectos</Button>
                </div>
            </div>
        </header>

        <ol class="home-projects__list">
            {
                featuredProjects.map((project, i) => (
                    <li class={`home-projects__item home-projects__item--${i}`}>
                        <ProjectCard
                            project={project}
                            index={i}
                            ratio={layout[i % layout.length].ratio}
                            sizes={layout[i % layout.length].sizes}
                        />
                    </li>
                ))
            }
        </ol>
    </div>
</section>

<style>
    .home-projects__head {
        display: grid;
        gap: 2rem;
        margin-bottom: clamp(3.5rem, 8vw, 8rem);
    }

    .home-projects__intro {
        display: grid;
        gap: 1.75rem;
        justify-items: start;
        max-width: 26rem;
    }

    @media (width >= 900px) {
        .home-projects__head {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
            align-items: end;
        }

        .home-projects__head :global(.chapter) {
            grid-column: 1 / -1;
        }

        .home-projects__head h2 {
            grid-column: 1 / 9;
        }

        .home-projects__intro {
            grid-column: 9 / 13;
            padding-bottom: 0.75rem;
        }
    }

    .home-projects__list {
        display: grid;
        gap: clamp(3.5rem, 8vw, 6rem);
    }

    @media (width >= 900px) {
        .home-projects__list {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
            row-gap: 0;
        }

        .home-projects__item--0 {
            grid-column: 1 / 8;
        }

        .home-projects__item--1 {
            grid-column: 9 / 13;
            margin-top: clamp(10rem, 22vw, 22rem);
        }

        .home-projects__item--2 {
            grid-column: 2 / 6;
            margin-top: clamp(4rem, 6vw, 7rem);
        }

        .home-projects__item--3 {
            grid-column: 7 / 13;
            margin-top: clamp(12rem, 20vw, 20rem);
        }
    }
</style>
