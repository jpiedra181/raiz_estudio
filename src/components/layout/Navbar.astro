---
const currentPath = Astro.url.pathname;
const links = [
    { label: "El Estudio", url: "/estudio" },
    { label: "Servicios", url: "/servicios" },
    { label: "Proyectos", url: "/proyectos" },
    { label: "Consultoría Online", url: "/consultoria-online" },
    { label: "Proceso", url: "/proceso" },
    { label: "Contacto", url: "/contacto" },
];
---

<header class="navbar">
    <div class="navbar-container">
        <div class="logo">
            <a href="/" class="logo-link">
                <span class="logo-text">Raíz</span>
                <span class="logo-subtext">Estudio</span>
            </a>
        </div>

        <!-- Desktop Nav -->
        <nav class="desktop-nav" aria-label="Navegación principal">
            <ul class="nav-links">
                {
                    links.map(({ label, url }) => (
                        <li>
                            <a
                                href={url}
                                class={`nav-link label-accent ${currentPath === url ? "active" : ""}`}
                            >
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <!-- Mobile Menu Button -->
        <button
            class="mobile-btn"
            aria-label="Abrir menú"
            aria-controls="mobile-menu"
            aria-expanded="false"
        >
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </div>
</header>

<!-- Mobile Menú Screen -->
<div id="mobile-menu" class="mobile-menu-wrapper" style="display: none;">
    <div class="mobile-overlay"></div>
    <div class="mobile-menu-content">
        <button class="mobile-close-btn" aria-label="Cerrar menú">
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav aria-label="Navegación móvil">
            <ul class="mobile-links">
                {
                    links.map(({ label, url }) => (
                        <li class="mobile-link">
                            <a href={url} class="font-heading">
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</div>

<script>
    import { initNavbar } from "../../scripts/navbar";
    document.addEventListener("astro:page-load", () => {
        initNavbar();
    });
</script>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 50;
        transition: all 0.3s ease;
        padding-block: 1.5rem;
    }

    .navbar.scrolled {
        padding-block: 1rem;
    }

    .navbar-container {
        max-width: var(--container-width);
        margin-inline: auto;
        padding-inline: var(--container-padding);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo-link {
        display: flex;
        flex-direction: column;
        color: var(--color-ink);
        text-decoration: none;
        z-index: 50;
        position: relative;
    }

    .logo-text {
        font-family: var(--font-family-heading);
        font-weight: var(--font-weight-regular);
        font-size: var(--text-2xl);
        letter-spacing: -0.02em;
        line-height: 1;
    }

    .logo-subtext {
        font-family: var(--font-family-heading);
        font-weight: var(--font-weight-bold);
        font-size: var(--text-lg);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        line-height: 1;
        opacity: 0.8;
        margin-top: 2px;
    }

    .desktop-nav {
        display: none;
    }

    @media (min-width: 1024px) {
        .desktop-nav {
            display: block;
        }
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .nav-link {
        position: relative;
        color: var(--color-ink);
        transition: color 0.3s;
    }

    .nav-link:hover,
    .nav-link.active {
        color: var(--color-accent);
    }

    .nav-link.active::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 100%;
        height: 1px;
        background-color: var(--color-accent);
    }

    .mobile-btn {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        height: 40px;
        width: 40px;
        color: var(--color-ink);
        z-index: 50;
        position: relative;
    }

    @media (min-width: 1024px) {
        .mobile-btn {
            display: none;
        }
    }

    .bar {
        width: 24px;
        height: 2px;
        background-color: currentColor;
        border-radius: 2px;
        display: block;
    }

    .mobile-menu-wrapper {
        position: fixed;
        inset: 0;
        z-index: 40;
    }

    .mobile-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(30, 23, 16, 0.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        opacity: 0;
    }

    .mobile-menu-content {
        position: relative;
        z-index: 10;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .mobile-close-btn {
        position: absolute;
        top: 1.5rem;
        right: var(--container-padding);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0px;
        height: 40px;
        width: 40px;
        color: var(--color-white);
        z-index: 50;
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .mobile-close-btn .bar:first-child {
        transform: rotate(45deg) translate(1px, 1px);
    }

    .mobile-close-btn .bar:last-child {
        transform: rotate(-45deg) translate(1px, -1px);
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        text-align: center;
    }

    .mobile-links a {
        font-size: var(--text-3xl);
        color: var(--color-white);
        transition: color 0.3s;
    }

    .mobile-links a:hover {
        color: var(--color-accent-light);
    }

    .mobile-link {
        opacity: 0;
    }
</style>
