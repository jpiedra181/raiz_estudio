---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={["logo", className]} aria-label="Raíz Estudio, ir al inicio">
    <span class="logo__word" aria-hidden="true">Raíz</span>
    <span class="logo__sub" aria-hidden="true">Estudio</span>
</a>

<style>
    .logo {
        display: inline-flex;
        align-items: baseline;
        gap: 0.6rem;
        color: inherit;
        line-height: 1;
    }

    .logo__word {
        font-family: var(--ff-serif);
        font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
        font-weight: 400;
        letter-spacing: -0.02em;
    }

    .logo__sub {
        font-size: 0.625rem;
        font-weight: 500;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        transform: translateY(-0.2em);
    }
</style>
