---
import Chapter from "./Chapter.astro";

interface Props {
    num: string;
    title: string;
    items: { question: string; answer: string }[];
}

const { num, title, items } = Astro.props;
const id = `faq-${num}`;
---

<section class="faq section" aria-labelledby={id}>
    <div class="wrap faq__grid">
        <header class="faq__head">
            <Chapter num={num} label="Preguntas frecuentes" />
            <h2 id={id} class="t-h2" data-split set:html={title} />
        </header>

        <div class="faq__list">
            {
                items.map((item) => (
                    <details class="faq__item" data-reveal>
                        <summary class="faq__summary">
                            <span class="faq__question">{item.question}</span>
                            <span class="faq__icon" aria-hidden="true" />
                        </summary>
                        <div class="faq__answer">
                            <p>{item.answer}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    .faq__grid {
        display: grid;
        gap: 3rem;
    }

    .faq__head {
        display: grid;
        gap: 2rem;
        align-content: start;
    }

    @media (width >= 1024px) {
        .faq__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
        }

        .faq__head {
            grid-column: 1 / 6;
        }

        .faq__list {
            grid-column: 7 / 13;
        }
    }

    .faq__list {
        border-top: 1px solid var(--line);
    }

    .faq__item {
        border-bottom: 1px solid var(--line);
    }

    .faq__summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding-block: 1.75rem;
        cursor: pointer;
        list-style: none;
    }

    .faq__summary::-webkit-details-marker {
        display: none;
    }

    .faq__question {
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
        line-height: 1.2;
        transition: color 0.3s ease;
    }

    .faq__summary:hover .faq__question {
        color: var(--accent);
    }

    .faq__icon {
        position: relative;
        flex: none;
        width: 2.75rem;
        height: 2.75rem;
        border: 1px solid var(--line-strong);
        border-radius: 50%;
    }

    .faq__icon::before,
    .faq__icon::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0.875rem;
        height: 1px;
        background-color: currentColor;
        translate: -50% -50%;
        transition: rotate 0.6s var(--ease-out);
    }

    .faq__icon::after {
        rotate: 90deg;
    }

    .faq__item[open] .faq__icon::after {
        rotate: 0deg;
    }

    .faq__answer {
        padding-bottom: 2rem;
        padding-right: 4rem;
        color: var(--fg-soft);
    }

    /* Smooth open/close where supported */
    @supports (interpolate-size: allow-keywords) {
        .faq__item {
            interpolate-size: allow-keywords;
        }

        .faq__item::details-content {
            height: 0;
            overflow: clip;
            transition:
                height 0.6s var(--ease-out),
                content-visibility 0.6s allow-discrete;
        }

        .faq__item[open]::details-content {
            height: auto;
        }
    }
</style>
