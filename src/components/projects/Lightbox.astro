---
import Arrow from "../ui/Arrow.astro";

interface Props {
    images: { src: string; alt: string }[];
    label: string;
}

const { images, label } = Astro.props;
const total = String(images.length).padStart(2, "0");
---

<dialog class="lightbox" aria-label={label} data-lightbox data-lenis-prevent>
    <script type="application/json" data-lightbox-images set:html={JSON.stringify(images)} is:inline></script>

    <div class="lightbox__bar">
        <p class="lightbox__count" aria-live="polite">
            <span class="visually-hidden">Imagen</span>
            <span data-lightbox-current>01</span>
            <span class="lightbox__total"><span class="visually-hidden">de</span> / {total}</span>
        </p>
        <button type="button" class="lightbox__close" data-lightbox-close>
            Cerrar
            <span class="lightbox__x" aria-hidden="true"><i></i><i></i></span>
        </button>
    </div>

    <figure class="lightbox__stage">
        <img class="lightbox__img" src="" alt="" decoding="async" data-lightbox-img />
    </figure>

    <div class="lightbox__nav">
        <button type="button" class="lightbox__btn" data-lightbox-prev aria-label="Imagen anterior">
            <Arrow direction="left" />
        </button>
        <button type="button" class="lightbox__btn" data-lightbox-next aria-label="Imagen siguiente">
            <Arrow />
        </button>
    </div>
</dialog>


<style>
    .lightbox {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        height: 100dvh;
        margin: 0;
        background-color: rgb(21 18 16 / 0.97);
        color: var(--c-paper);
        overflow: hidden;
    }

    .lightbox[open] {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
    }

    .lightbox::backdrop {
        background: transparent;
    }

    .lightbox__bar,
    .lightbox__nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem var(--gutter);
    }

    .lightbox__count {
        font-size: var(--fs-sm);
        letter-spacing: 0.08em;
        font-variant-numeric: tabular-nums;
    }

    .lightbox__total {
        color: var(--c-paper-soft);
    }

    .lightbox__close {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 2.75rem;
        font-size: var(--fs-xs);
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .lightbox__x {
        position: relative;
        width: 1.25rem;
        height: 1.25rem;
    }

    .lightbox__x i {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 1px;
        background-color: currentColor;
        rotate: 45deg;
    }

    .lightbox__x i + i {
        rotate: -45deg;
    }

    .lightbox__stage {
        display: grid;
        place-items: center;
        min-height: 0;
        padding-inline: var(--gutter);
    }

    .lightbox__img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        user-select: none;
    }

    .lightbox__nav {
        justify-content: center;
        gap: 1rem;
        padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
    }

    .lightbox__btn {
        display: inline-grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        border: 1px solid rgb(246 241 234 / 0.35);
        border-radius: 50%;
        transition:
            background-color 0.4s ease,
            color 0.4s ease;
    }

    .lightbox__btn :global(svg) {
        width: 1rem;
        height: 1rem;
    }

    .lightbox__btn:hover {
        background-color: var(--c-paper);
        color: var(--c-night);
    }
</style>
