---
import type { Project } from "../../data/projects";
import Media from "../ui/Media.astro";
import Arrow from "../ui/Arrow.astro";

interface Props {
    project: Project;
    index: number;
    ratio?: string;
    sizes?: string;
    headingLevel?: "h2" | "h3";
    /** Load the image eagerly (first card above the fold) */
    eager?: boolean;
    class?: string;
}

const {
    project,
    index,
    ratio = "4 / 5",
    sizes = "(min-width: 900px) 45vw, 100vw",
    headingLevel: Heading = "h3",
    eager = false,
    class: className,
} = Astro.props;
---

<article class:list={["pcard", className]}>
    <a href={`/proyectos/${project.slug}`} class="pcard__link" data-cursor="Ver">
        <Media
            src={project.images[0]}
            alt=""
            ratio={ratio}
            sizes={sizes}
            eager={eager}
            reveal
            parallax={0.1}
            transitionName={`project-${project.slug}`}
            class="pcard__media"
        />
        <div class="pcard__meta">
            <span class="pcard__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <Heading class="pcard__title">{project.name}</Heading>
            <p class="pcard__info">
                <span>{project.location}</span>
                <span aria-hidden="true">·</span>
                <span>{project.year}</span>
            </p>
            <Arrow class="pcard__arrow" />
        </div>
    </a>
</article>

<style>
    .pcard__link {
        display: block;
    }

    .pcard__meta {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: baseline;
        column-gap: 1rem;
        row-gap: 0.35rem;
        padding-top: 1.25rem;
    }

    .pcard__index {
        grid-row: 1 / 3;
        font-size: var(--fs-xs);
        font-weight: 500;
        letter-spacing: 0.12em;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
    }

    .pcard__title {
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.01em;
        transition: color 0.4s ease;
    }

    .pcard__info {
        grid-column: 2;
        display: flex;
        gap: 0.5rem;
        font-size: var(--fs-sm);
        color: var(--fg-soft);
    }

    .pcard__meta :global(.pcard__arrow) {
        grid-column: 3;
        grid-row: 1;
        width: 1.1rem;
        height: 1.1rem;
        opacity: 0;
        transform: translate3d(-0.75rem, 0, 0);
        transition:
            opacity 0.5s ease,
            transform 0.7s var(--ease-out);
    }

    @media (hover: hover) {
        .pcard__link:hover :global(picture) {
            transform: scale(1.05);
        }

        .pcard__link:hover .pcard__title {
            color: var(--accent);
        }

        .pcard__link:hover :global(.pcard__arrow) {
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
    }

    .pcard__link:focus-visible {
        outline-offset: 8px;
    }
</style>
