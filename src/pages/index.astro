---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeIntro from "../components/home/HomeIntro.astro";
import HomeProjects from "../components/home/HomeProjects.astro";
import HomeServices from "../components/home/HomeServices.astro";
import HomeManifesto from "../components/home/HomeManifesto.astro";
import HomeProcess from "../components/home/HomeProcess.astro";
import HomeTestimonials from "../components/home/HomeTestimonials.astro";
import Marquee from "../components/ui/Marquee.astro";
import { site } from "../data/site";
import { images } from "../data/studio";

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "InteriorDesigner",
    name: site.name,
    url: site.url,
    email: site.email,
    telephone: site.phone,
    description: site.description,
    address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        postalCode: site.address.postalCode,
        addressLocality: site.address.city,
        addressCountry: "ES",
    },
    geo: { "@type": "GeoCoordinates", latitude: site.coords[0], longitude: site.coords[1] },
    areaServed: "ES",
    sameAs: site.social.map((s) => s.href),
};
---

<BaseLayout title={site.name} image={images.homeHero} headerTheme="light">
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <HomeHero />
    <HomeIntro />
    <HomeProjects />
    <HomeServices />
    <HomeManifesto />
    <HomeProcess />
    <HomeTestimonials />
    <Marquee
        class="home-marquee"
        italic
        items={["Interiorismo residencial", "Consultoría online", "Materiales honestos", "Hogares atemporales"]}
    />
</BaseLayout>

<style>
    :global(.home-marquee) {
        padding-block: clamp(3rem, 7vw, 6rem);
        background-color: var(--c-linen);
        border-top: 1px solid var(--line);
    }
</style>
