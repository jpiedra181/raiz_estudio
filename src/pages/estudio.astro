---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Chapter from "../components/ui/Chapter.astro";
import Media from "../components/ui/Media.astro";
import Marquee from "../components/ui/Marquee.astro";
import { brands, images, team, values } from "../data/studio";
---

<BaseLayout
    title="El estudio"
    description="Raíz Estudio nace para devolver el alma a los espacios habitados. Conoce a nuestro equipo y lo que nos mueve."
    image={images.studioHero}
>
    <PageHero
        eyebrow="El estudio"
        title="Tu casa merece|ser <em>única</em>"
        intro="Nacimos de una convicción muy personal: devolver el alma a los espacios habitados, lejos de las tendencias que estandarizan los hogares."
        image={images.studioHero}
        imageAlt="Rincón cálido con pared verde salvia, espejo redondo, aparador de madera y plantas"
        position="50% 60%"
    />

    <section class="story section" aria-labelledby="story-title">
        <div class="wrap story__grid">
            <div class="story__side">
                <Chapter num="01" label="Nuestra historia" />
            </div>
            <div class="story__main">
                <h2 id="story-title" class="t-lead" data-words>
                    El interiorismo no consiste en imponer un estilo, sino en traducir quién eres al lenguaje del
                    espacio, la luz y los materiales.
                </h2>
                <div class="story__columns t-soft">
                    <p data-reveal>
                        Raíz Estudio surgió de una necesidad muy personal. Durante años vimos cómo las tendencias
                        estandarizaban los hogares, convirtiéndolos en lugares hermosos pero fríos.
                    </p>
                    <p data-reveal>
                        Trabajamos con texturas naturales, maderas cálidas y una paleta inspirada en la tierra, porque
                        son los elementos que nos conectan con la calma. Nuestro enfoque es humano, cercano y
                        totalmente a medida: al final del día, tu casa es el lugar más importante del mundo.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="team section theme-linen" aria-labelledby="team-title">
        <div class="wrap">
            <header class="team__head">
                <Chapter num="02" label="Equipo" />
                <h2 id="team-title" class="t-h1" data-split>Las manos detrás <em>de cada casa</em></h2>
            </header>

            <ul class="team__grid">
                {
                    team.map((member, i) => (
                        <li class:list={["member", i % 2 === 1 && "member--offset"]}>
                            <Media
                                src={member.image}
                                alt={`Retrato de ${member.name}`}
                                ratio="4 / 5"
                                preset="medium"
                                sizes="(min-width: 768px) 40vw, 100vw"
                                reveal
                                parallax={0.08}
                                class="member__photo"
                            />
                            <div class="member__body">
                                <h3 class="t-h3">{member.name}</h3>
                                <p class="eyebrow t-accent">{member.role}</p>
                                <blockquote class="member__quote">
                                    <p>«{member.quote}»</p>
                                </blockquote>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="values section theme-dark" aria-labelledby="values-title">
        <div class="wrap">
            <header class="values__head">
                <Chapter num="03" label="Valores" />
                <h2 id="values-title" class="t-h1" data-split>Lo que <em>nos mueve</em></h2>
            </header>
            <ol class="values__grid">
                {
                    values.map((value, i) => (
                        <li class="value" data-reveal>
                            <span class="value__num" aria-hidden="true">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <h3 class="t-h3">{value.title}</h3>
                            <p class="t-soft">{value.text}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="brands" aria-labelledby="brands-title">
        <div class="wrap brands__head">
            <Chapter num="04" label="Firmas" />
            <h2 id="brands-title" class="t-h3" data-split>Trabajamos con firmas <em>que admiramos</em></h2>
        </div>
        <Marquee items={brands} label="Firmas con las que trabajamos" speed={45} class="brands__marquee" />
    </section>

    <section class="studio-space" aria-label="Nuestro espacio">
        <Media
            src={images.studioSpace}
            alt="Salón con pared verde profundo, sofá de terciopelo y obra gráfica en blanco y negro"
            preset="full"
            sizes="100vw"
            ratio="21 / 9"
            parallax={0.15}
            class="studio-space__media"
        />
    </section>
</BaseLayout>

<style>
    /* Story */
    .story__grid {
        display: grid;
        gap: 2rem;
    }

    .story__main {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .story__columns {
        display: grid;
        gap: 1.5rem var(--gap);
    }

    @media (width >= 768px) {
        .story__columns {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (width >= 1024px) {
        .story__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
        }

        .story__side {
            grid-column: 1 / 4;
            padding-top: 0.9em;
        }

        .story__main {
            grid-column: 4 / 13;
        }
    }

    /* Team */
    .team__head,
    .values__head {
        display: grid;
        gap: 2rem;
        margin-bottom: clamp(3rem, 7vw, 6rem);
    }

    .team__grid {
        display: grid;
        gap: 4rem;
    }

    @media (width >= 768px) {
        .team__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
        }

        .member {
            grid-column: 1 / 6;
        }

        .member--offset {
            grid-column: 8 / 13;
            margin-top: clamp(6rem, 16vw, 16rem);
        }
    }

    .member__body {
        display: grid;
        gap: 0.75rem;
        padding-top: 1.75rem;
    }

    .member__quote {
        margin-top: 0.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
        font-style: italic;
        font-weight: 300;
        line-height: 1.3;
    }

    /* Values */
    .values__grid {
        display: grid;
        gap: 0 var(--gap);
    }

    @media (width >= 768px) {
        .values__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .value {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: baseline;
        gap: 0.75rem 1.5rem;
        padding-block: clamp(2rem, 4vw, 3rem);
        border-top: 1px solid var(--line);
    }

    .value__num {
        grid-row: 1 / 3;
        font-size: var(--fs-xs);
        font-weight: 500;
        letter-spacing: 0.12em;
        color: var(--accent);
    }

    .value p {
        max-width: 30rem;
    }

    /* Brands */
    .brands {
        padding-top: var(--section);
        padding-bottom: clamp(3rem, 6vw, 5rem);
        overflow: hidden;
    }

    .brands__head {
        display: grid;
        gap: 2rem;
        margin-bottom: clamp(2rem, 5vw, 4rem);
    }

    .brands :global(.brands__marquee) {
        padding-block: 1.5rem;
        border-block: 1px solid var(--line);
        color: var(--fg-soft);
    }

    .studio-space :global(.studio-space__media) {
        min-height: 22rem;
    }
</style>
