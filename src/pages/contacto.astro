---
import "leaflet/dist/leaflet.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../data/site";
import { images } from "../data/studio";
import { introLines } from "../lib/intro";

// Optional form backend (e.g. Formspree). Without it the form opens the email client
// when JS is off, and shows a simulated confirmation when JS is on.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;

const services = [
    { value: "interiorismo-completo", label: "Interiorismo completo" },
    { value: "consultoria-online", label: "Consultoría online" },
    { value: "solo-habitacion", label: "Solo una estancia" },
    { value: "orientacion", label: "Aún no lo sé, necesito orientación" },
];

const budgets = [
    { value: "menos-5k", label: "Menos de 5.000 €" },
    { value: "5k-15k", label: "5.000 € – 15.000 €" },
    { value: "15k-30k", label: "15.000 € – 30.000 €" },
    { value: "mas-30k", label: "Más de 30.000 €" },
    { value: "prefiero-no-decirlo", label: "Prefiero no decirlo" },
];

const mapUrl = `https://www.openstreetmap.org/?mlat=${site.coords[0]}&mlon=${site.coords[1]}#map=16/${site.coords[0]}/${site.coords[1]}`;
---

<BaseLayout
    title="Contacto"
    description="Cuéntanos sobre tu casa. Escríbenos a hola@raizestudio.es o rellena el formulario y te responderemos en menos de 48 horas."
    image={images.contact}
>
    <section class="contact" aria-labelledby="page-title">
        <div class="wrap contact__grid">
            <div class="contact__intro">
                <p class="eyebrow t-accent" data-intro style="--i: 0">Contacto</p>
                <h1 id="page-title" class="t-display" set:html={introLines("Hablemos", 1)} />
                <p class="t-lg t-soft contact__lead" data-intro style="--i: 2">
                    Cuéntanos cómo es tu espacio, qué necesitas y cómo te imaginas viviendo en él. Te responderemos en
                    menos de 48 horas laborables.
                </p>

                <dl class="contact__info" data-intro style="--i: 3">
                    <div>
                        <dt class="eyebrow t-soft">Email</dt>
                        <dd><a href={`mailto:${site.email}`} class="contact__big">{site.email}</a></dd>
                    </div>
                    <div>
                        <dt class="eyebrow t-soft">Teléfono</dt>
                        <dd>
                            <a href={site.phoneHref} class="contact__big">{site.phone}</a>
                            <span class="t-sm t-soft contact__hours">{site.hours}</span>
                        </dd>
                    </div>
                    <div>
                        <dt class="eyebrow t-soft">Estudio</dt>
                        <dd>
                            <address class="contact__address">
                                {site.address.street}<br />
                                {site.address.postalCode} {site.address.city}, {site.address.country}
                            </address>
                        </dd>
                    </div>
                </dl>
            </div>

            <div class="contact__form-wrap" data-intro style="--i: 3">
                <form
                    class="cform"
                    action={endpoint ?? `mailto:${site.email}`}
                    method="post"
                    enctype={endpoint ? undefined : "text/plain"}
                    novalidate
                    data-contact-form
                    data-endpoint={endpoint}
                >
                    <h2 class="t-h3 cform__title">Cuéntanos tu proyecto</h2>
                    <p class="t-sm t-soft cform__note">Los campos marcados con <span aria-hidden="true">*</span><span class="visually-hidden">asterisco</span> son obligatorios.</p>

                    <div class="field">
                        <label for="name" class="field__label">Nombre completo <span aria-hidden="true">*</span></label>
                        <input id="name" name="name" type="text" class="field__input" autocomplete="name" required aria-describedby="name-error" />
                        <p id="name-error" class="field__error" hidden>Indica tu nombre, por favor.</p>
                    </div>

                    <div class="cform__row">
                        <div class="field">
                            <label for="email" class="field__label">Email <span aria-hidden="true">*</span></label>
                            <input id="email" name="email" type="email" class="field__input" autocomplete="email" required aria-describedby="email-error" />
                            <p id="email-error" class="field__error" hidden>Introduce un email válido, por ejemplo nombre@dominio.com.</p>
                        </div>
                        <div class="field">
                            <label for="phone" class="field__label">Teléfono</label>
                            <input id="phone" name="phone" type="tel" class="field__input" autocomplete="tel" inputmode="tel" />
                        </div>
                    </div>

                    <div class="cform__row">
                        <div class="field">
                            <label for="service" class="field__label">Tipo de servicio <span aria-hidden="true">*</span></label>
                            <div class="field__select">
                                <select id="service" name="service" class="field__input" required aria-describedby="service-error">
                                    <option value="" selected disabled>Selecciona una opción</option>
                                    {services.map((s) => <option value={s.value}>{s.label}</option>)}
                                </select>
                            </div>
                            <p id="service-error" class="field__error" hidden>Elige el servicio que te interesa.</p>
                        </div>
                        <div class="field">
                            <label for="budget" class="field__label">Presupuesto orientativo</label>
                            <div class="field__select">
                                <select id="budget" name="budget" class="field__input">
                                    <option value="" selected>Selecciona un rango</option>
                                    {budgets.map((b) => <option value={b.value}>{b.label}</option>)}
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="message" class="field__label">Tu proyecto <span aria-hidden="true">*</span></label>
                        <textarea id="message" name="message" rows="5" class="field__input" required aria-describedby="message-hint message-error"></textarea>
                        <p id="message-hint" class="field__hint">¿Cómo es el espacio? ¿Qué te gustaría conseguir?</p>
                        <p id="message-error" class="field__error" hidden>Déjanos un breve mensaje para poder ayudarte.</p>
                    </div>

                    <div class="cform__trap" aria-hidden="true">
                        <label for="company">No rellenes este campo</label>
                        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="cform__footer">
                        <p class="t-sm t-soft">Usaremos tus datos únicamente para responder a tu consulta.</p>
                        <Button type="submit" variant="solid" class="cform__submit">Enviar consulta</Button>
                    </div>
                    <p class="cform__status" role="status" data-form-status></p>
                </form>

                <div class="cform-success theme-dark" tabindex="-1" hidden data-form-success>
                    <p class="eyebrow t-accent">Mensaje enviado</p>
                    <h2 class="t-h2">Gracias por <em>escribirnos</em></h2>
                    <p class="t-soft">Hemos recibido tu mensaje. Te responderemos muy pronto para hablar de tu casa.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="map-section" aria-label="Ubicación del estudio">
        <div class="map" data-map data-lat={site.coords[0]} data-lng={site.coords[1]}>
            <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map__fallback link">
                Ver ubicación en OpenStreetMap
                <span class="visually-hidden">(se abre en una pestaña nueva)</span>
            </a>
        </div>
    </section>
</BaseLayout>


<style>
    .contact {
        padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
        padding-bottom: var(--section);
    }

    .contact__grid {
        display: grid;
        gap: clamp(3.5rem, 7vw, 6rem);
    }

    @media (width >= 1024px) {
        .contact__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
            align-items: start;
        }

        .contact__intro {
            grid-column: 1 / 6;
            position: sticky;
            top: calc(var(--header-h) + 2rem);
        }

        .contact__form-wrap {
            grid-column: 7 / 13;
        }
    }

    .contact__intro {
        display: grid;
        gap: 1.75rem;
        align-content: start;
    }

    .contact__lead {
        max-width: 30rem;
    }

    .contact__info {
        display: grid;
        gap: 1.75rem;
        margin-top: 1.5rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
    }

    .contact__info dt {
        margin-bottom: 0.5rem;
    }

    .contact__big {
        font-family: var(--ff-serif);
        font-size: var(--fs-h3);
        line-height: 1.2;
        background-image: linear-gradient(currentColor, currentColor);
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: background-size 0.6s var(--ease-out);
        overflow-wrap: anywhere;
    }

    .contact__big:hover {
        background-size: 100% 1px;
    }

    .contact__hours {
        display: block;
        margin-top: 0.35rem;
    }

    .contact__address {
        font-size: var(--fs-lg);
    }

    /* Form */
    .cform {
        display: grid;
        gap: 1.75rem;
        padding: clamp(1.5rem, 4vw, 3.5rem);
        background-color: var(--c-linen);
    }

    .cform__title {
        margin-bottom: -0.75rem;
    }

    .cform__row {
        display: grid;
        gap: 1.75rem;
    }

    @media (width >= 640px) {
        .cform__row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: 1.5rem;
        }
    }

    .field {
        display: grid;
        gap: 0.5rem;
    }

    .field__label {
        font-size: var(--fs-xs);
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .field__input {
        width: 100%;
        min-height: 3rem;
        padding: 0.65rem 0;
        border: 0;
        border-bottom: 1px solid var(--line-strong);
        border-radius: 0;
        background: transparent;
        font-size: 1.0625rem;
        appearance: none;
        transition: border-color 0.3s ease;
    }

    textarea.field__input {
        resize: vertical;
        min-height: 8rem;
        line-height: 1.6;
    }

    .field__input:hover {
        border-color: var(--fg);
    }

    .field__input:focus-visible {
        outline: none;
        border-color: var(--fg);
        box-shadow: 0 2px 0 0 var(--fg);
    }

    .field__input[aria-invalid="true"] {
        border-color: var(--c-error);
        box-shadow: 0 2px 0 0 var(--c-error);
    }

    .field__select {
        position: relative;
    }

    .field__select::after {
        content: "";
        position: absolute;
        right: 0.25rem;
        top: 50%;
        width: 0.5rem;
        height: 0.5rem;
        border-right: 1px solid currentColor;
        border-bottom: 1px solid currentColor;
        translate: 0 -75%;
        rotate: 45deg;
        pointer-events: none;
    }

    .field__select select {
        padding-right: 2rem;
        cursor: pointer;
    }

    .field__hint {
        font-size: var(--fs-sm);
        color: var(--fg-soft);
    }

    .field__error {
        font-size: var(--fs-sm);
        color: var(--c-error);
    }

    .cform__trap {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    .cform__footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem 2rem;
        padding-top: 0.5rem;
    }

    .cform__footer p {
        max-width: 18rem;
    }

    .cform__status:empty {
        display: none;
    }

    .cform__status {
        font-size: var(--fs-sm);
    }

    .cform-success {
        display: grid;
        gap: 1.5rem;
        padding: clamp(2rem, 5vw, 4rem);
    }

    .cform-success[hidden] {
        display: none;
    }

    .cform-success:focus {
        outline: none;
    }

    /* Map */
    .map {
        position: relative;
        display: grid;
        place-items: center;
        height: clamp(22rem, 50vw, 36rem);
        background-color: var(--c-linen);
        z-index: 0;
    }

    .map.is-ready .map__fallback {
        display: none;
    }

    .map :global(.leaflet-tile-pane) {
        filter: grayscale(1) sepia(0.3) contrast(0.85) brightness(1.06);
    }

    .map :global(.map__marker) {
        border-radius: 50%;
        background-color: var(--c-bronze);
        box-shadow:
            0 0 0 4px var(--c-bone),
            0 0 0 5px var(--c-bronze);
    }

    .map :global(.leaflet-container) {
        font-family: var(--ff-sans);
    }

    .map :global(.leaflet-control-attribution) {
        background-color: rgb(243 238 230 / 0.9);
        color: var(--c-ink-soft);
        font-size: 0.6875rem;
    }

    .map :global(.leaflet-control-attribution a) {
        color: var(--c-ink);
    }
</style>
