---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Chapter from "../components/ui/Chapter.astro";
import Media from "../components/ui/Media.astro";
import Faq from "../components/ui/Faq.astro";
import { images, processSteps } from "../data/studio";

const faqs = [
    {
        question: "¿Qué pasa si mi presupuesto es ajustado?",
        answer: "La honestidad desde la primera llamada es clave. Si conocemos tus números reales desde el principio, adaptaremos nuestras propuestas a ese marco para evitar sorpresas.",
    },
    {
        question: "¿Puedo conservar muebles que ya tengo?",
        answer: "Por supuesto. De hecho, nos encanta integrar piezas con historia personal. Solo necesitamos saberlo antes de diseñar, para que el conjunto tenga sentido.",
    },
];
---

<BaseLayout
    title="Proceso"
    description="Así trabajamos en Raíz Estudio: un proceso claro, organizado y transparente, desde la primera llamada hasta la entrega y el estilismo final."
    image={images.processHero}
    headerTheme="light"
>
    <PageHero
        variant="image"
        eyebrow="El proceso"
        title="Así damos forma|<em>a tu hogar</em>"
        intro="Un proceso claro, organizado y transparente, para que disfrutes del camino tanto como del resultado."
        image={images.processHero}
        imageAlt="Cocina lineal de madera clara que se abre a un jardín frondoso"
        position="50% 60%"
    />

    <section class="timeline section" aria-labelledby="timeline-title" data-timeline>
        <div class="wrap">
            <header class="timeline__head">
                <Chapter num="01" label="Paso a paso" />
                <h2 id="timeline-title" class="t-h1" data-split>Cinco etapas, <em>un mismo cuidado</em></h2>
            </header>

            <div class="timeline__body">
                <span class="timeline__track" aria-hidden="true"><span class="timeline__progress" data-timeline-progress></span></span>
                <ol class="timeline__list">
                    {
                        processSteps.map((step, i) => (
                            <li class:list={["tstep", i % 2 === 1 && "tstep--alt"]}>
                                <span class="tstep__dot" aria-hidden="true" />
                                <div class="tstep__text">
                                    <span class="tstep__num" aria-hidden="true" data-reveal>
                                        {step.num}
                                    </span>
                                    <h3 class="t-h2" data-split>
                                        {step.title}
                                    </h3>
                                    <p class="t-lg t-soft" data-reveal>
                                        {step.description}
                                    </p>
                                </div>
                                <Media
                                    src={step.image}
                                    alt=""
                                    ratio="4 / 3"
                                    preset="medium"
                                    sizes="(min-width: 1024px) 40vw, 100vw"
                                    reveal
                                    parallax={0.1}
                                    class="tstep__media"
                                />
                            </li>
                        ))
                    }
                </ol>
            </div>
        </div>
    </section>

    <Faq num="02" title="Dudas sobre <em>el proceso</em>" items={faqs} />
</BaseLayout>


<style>
    .timeline__head {
        display: grid;
        gap: 2rem;
        margin-bottom: clamp(4rem, 9vw, 8rem);
    }

    .timeline__body {
        position: relative;
    }

    .timeline__track {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0.4rem;
        width: 1px;
        background-color: var(--line);
    }

    .timeline__progress {
        position: absolute;
        inset: 0;
        background-color: var(--accent);
        transform-origin: top;
    }

    .timeline__list {
        display: grid;
        gap: clamp(5rem, 12vw, 11rem);
    }

    .tstep {
        position: relative;
        display: grid;
        gap: 2.5rem;
        padding-left: 2.5rem;
    }

    .tstep__dot {
        position: absolute;
        top: 1.25rem;
        left: 0;
        width: 0.8125rem;
        height: 0.8125rem;
        border: 1px solid var(--accent);
        border-radius: 50%;
        background-color: var(--bg);
    }

    .tstep__text {
        display: grid;
        gap: 1.5rem;
        align-content: start;
        max-width: 34rem;
    }

    .tstep__num {
        font-family: var(--ff-serif);
        font-size: clamp(3.5rem, 2.5rem + 3vw, 6rem);
        font-style: italic;
        font-weight: 300;
        line-height: 0.9;
        color: var(--accent);
    }

    @media (width >= 1024px) {
        .timeline__track {
            left: 50%;
        }

        .tstep {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
            padding-left: 0;
            align-items: center;
        }

        .tstep__dot {
            left: 50%;
            translate: -50% 0;
            top: 50%;
        }

        .tstep__text {
            grid-column: 1 / 6;
            grid-row: 1;
        }

        .tstep :global(.tstep__media) {
            grid-column: 8 / 13;
            grid-row: 1;
        }

        .tstep--alt .tstep__text {
            grid-column: 8 / 13;
        }

        .tstep--alt :global(.tstep__media) {
            grid-column: 1 / 6;
        }
    }
</style>
