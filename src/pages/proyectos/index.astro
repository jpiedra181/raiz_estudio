---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import { projects } from "../../data/projects";

const styles = [...new Set(projects.map((p) => p.style))];
const countFor = (style: string) => projects.filter((p) => p.style === style).length;
const ratios = ["4 / 5", "5 / 4", "5 / 4", "4 / 5"];
---

<BaseLayout
    title="Proyectos"
    description="Proyectos de interiorismo residencial de Raíz Estudio en Madrid, Barcelona, Valencia, Girona, Sevilla y Navarra."
    image={projects[0].images[0]}
>
    <PageHero
        eyebrow={`Proyectos · ${String(projects.length).padStart(2, "0")}`}
        title="Hogares que|hemos <em>creado</em>"
        intro="Viviendas pensadas desde dentro: para la familia que las habita, la luz que reciben y el paisaje que las rodea."
    />

    <section class="portfolio" aria-label="Listado de proyectos" data-portfolio>
        <div class="wrap">
            <div class="portfolio__filters" role="group" aria-label="Filtrar por estilo" data-reveal>
                <button type="button" class="filter" aria-pressed="true" data-filter="all">
                    Todos <span class="filter__count">{projects.length}</span>
                </button>
                {
                    styles.map((style) => (
                        <button type="button" class="filter" aria-pressed="false" data-filter={style}>
                            {style} <span class="filter__count">{countFor(style)}</span>
                        </button>
                    ))
                }
            </div>
            <p class="visually-hidden" aria-live="polite" data-portfolio-status></p>

            <ul class="portfolio__grid">
                {
                    projects.map((project, i) => (
                        <li class:list={["portfolio__item", i % 2 === 1 && "is-shifted"]} data-style={project.style}>
                            <ProjectCard
                                project={project}
                                index={i}
                                ratio={ratios[i % ratios.length]}
                                sizes="(min-width: 768px) 46vw, 100vw"
                                headingLevel="h2"
                                eager={i === 0}
                            />
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>
</BaseLayout>


<style>
    .portfolio {
        padding-bottom: var(--section);
    }

    .portfolio__filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding-bottom: clamp(2.5rem, 5vw, 4rem);
        margin-bottom: clamp(2.5rem, 5vw, 4rem);
        border-bottom: 1px solid var(--line);
    }

    .filter {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 2.75rem;
        padding: 0.5rem 1.25rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        font-size: var(--fs-xs);
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition:
            background-color 0.4s ease,
            color 0.4s ease,
            border-color 0.4s ease;
    }

    .filter__count {
        font-size: 0.6875rem;
        color: var(--fg-soft);
        transition: color 0.4s ease;
    }

    .filter:hover {
        border-color: var(--fg);
    }

    .filter[aria-pressed="true"] {
        background-color: var(--c-ink);
        border-color: var(--c-ink);
        color: var(--c-paper);
    }

    .filter[aria-pressed="true"] .filter__count {
        color: var(--c-sand);
    }

    .portfolio__grid {
        display: grid;
        gap: clamp(3rem, 7vw, 5rem);
    }

    @media (width >= 768px) {
        .portfolio__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: clamp(1.5rem, 5vw, 6rem);
            align-items: start;
        }

        /* Staggered second column (translate keeps the grid rows compact) */
        .portfolio__grid {
            padding-bottom: clamp(5rem, 12vw, 12rem);
        }

        .portfolio__item.is-shifted {
            translate: 0 clamp(5rem, 12vw, 12rem);
        }
    }
</style>
