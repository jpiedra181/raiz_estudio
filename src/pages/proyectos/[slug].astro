---
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Media from "../../components/ui/Media.astro";
import Chapter from "../../components/ui/Chapter.astro";
import Arrow from "../../components/ui/Arrow.astro";
import Lightbox from "../../components/projects/Lightbox.astro";
import { projects, getAdjacentProject, type Project } from "../../data/projects";
import { resolveImage } from "../../lib/images";
import { introLines } from "../../lib/intro";

export function getStaticPaths() {
    return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
    project: Project;
}

const { project } = Astro.props;
const next = getAdjacentProject(project.slug);
const gallery = project.images.slice(1);

// Editorial rhythm for the gallery, repeated as needed
const layout = [
    { span: "full", ratio: "16 / 9", sizes: "(min-width: 1680px) 1540px, 92vw" },
    { span: "left", ratio: "4 / 5", sizes: "(min-width: 900px) 50vw, 92vw" },
    { span: "right", ratio: "4 / 5", sizes: "(min-width: 900px) 38vw, 92vw" },
    { span: "center", ratio: "3 / 2", sizes: "(min-width: 900px) 64vw, 92vw" },
    { span: "narrow", ratio: "3 / 4", sizes: "(min-width: 900px) 34vw, 92vw" },
    { span: "wide", ratio: "5 / 4", sizes: "(min-width: 900px) 52vw, 92vw" },
    { span: "full", ratio: "16 / 9", sizes: "(min-width: 1680px) 1540px, 92vw" },
];

// Large renditions for the lightbox
const fullSize = await Promise.all(
    gallery.map(async (src) => {
        const resolved = resolveImage(src);
        const image = await getImage({
            src: resolved,
            inferSize: typeof resolved === "string",
            width: 2000,
            format: "webp",
        });
        return image.src;
    }),
);

const altFor = (i: number) => `${project.name}, ${project.location}. Imagen ${i + 1} de ${gallery.length}`;
---

<BaseLayout title={project.name} description={project.summary} image={project.images[0]} headerTheme="light">
    <section class="project-hero theme-dark" aria-labelledby="page-title">
        <Media
            src={project.images[0]}
            alt={`${project.name}, interior principal`}
            preset="full"
            sizes="100vw"
            priority
            transitionName={`project-${project.slug}`}
            class="project-hero__bg"
            data-hero-bg
        />
        <div class="project-hero__shade" aria-hidden="true"></div>

        <div class="wrap project-hero__content">
            <a href="/proyectos" class="link project-hero__back" data-intro style="--i: 0">
                <Arrow direction="left" /> Proyectos
            </a>
            <h1 id="page-title" class="t-display project-hero__title" set:html={introLines(project.name, 1)} />
            <dl class="project-hero__meta" data-intro style="--i: 3">
                <div>
                    <dt>Ubicación</dt>
                    <dd>{project.location}</dd>
                </div>
                <div>
                    <dt>Año</dt>
                    <dd>{project.year}</dd>
                </div>
                <div>
                    <dt>Superficie</dt>
                    <dd>{project.sqm} m²</dd>
                </div>
                <div>
                    <dt>Estilo</dt>
                    <dd>{project.style}</dd>
                </div>
            </dl>
        </div>
    </section>

    <section class="project-intro section" aria-labelledby="intro-title">
        <div class="wrap project-intro__grid">
            <div class="project-intro__side">
                <Chapter num="01" label="El proyecto" />
            </div>
            <div class="project-intro__main">
                <h2 id="intro-title" class="t-lead" data-words>{project.summary}</h2>
                <div class="prose t-lg t-soft project-intro__text">
                    {project.description.map((paragraph) => <p data-reveal>{paragraph}</p>)}
                </div>
            </div>
        </div>
    </section>

    <section class="project-gallery" aria-label="Galería de imágenes">
        <ul class="wrap project-gallery__grid">
            {
                gallery.map((src, i) => {
                    const item = layout[i % layout.length];
                    return (
                        <li class={`project-gallery__item project-gallery__item--${item.span}`}>
                            <button
                                type="button"
                                class="project-gallery__trigger"
                                data-lightbox-open={i}
                                data-cursor="Ampliar"
                                aria-label={`Ampliar imagen ${i + 1} de ${gallery.length}`}
                            >
                                <Media
                                    src={src}
                                    alt={altFor(i)}
                                    ratio={item.ratio}
                                    sizes={item.sizes}
                                    reveal
                                    parallax={0.08}
                                />
                            </button>
                        </li>
                    );
                })
            }
        </ul>
    </section>

    <section class="project-palette section" aria-labelledby="palette-title">
        <div class="wrap">
            <div class="project-palette__head">
                <Chapter num="02" label="Materiales" />
                <h2 id="palette-title" class="t-h2" data-split>La <em>paleta</em></h2>
            </div>
            <ul class="project-palette__list">
                {
                    project.materials.map((material) => (
                        <li class="swatch" data-reveal>
                            <span class="swatch__color" style={`background-color: ${material.colorHex}`} />
                            <span class="swatch__name">{material.name}</span>
                            <span class="swatch__hex">{material.colorHex}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="next-project theme-dark" aria-label="Siguiente proyecto">
        <a href={`/proyectos/${next.slug}`} class="next-project__link" data-cursor="Ver">
            <Media
                src={next.images[0]}
                alt=""
                preset="full"
                sizes="100vw"
                parallax={0.12}
                transitionName={`project-${next.slug}`}
                class="next-project__bg"
            />
            <span class="next-project__shade" aria-hidden="true"></span>
            <span class="wrap next-project__content">
                <span class="eyebrow next-project__eyebrow">Siguiente proyecto</span>
                <span class="t-h1 next-project__title">{next.name}</span>
                <span class="next-project__meta">{next.location} · {next.year}</span>
            </span>
        </a>
    </section>

    <Lightbox
        images={fullSize.map((src, i) => ({ src, alt: altFor(i) }))}
        label={`Galería de ${project.name}`}
    />
</BaseLayout>


<style>
    /* Hero */
    .project-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        min-height: 100vh;
        min-height: 100svh;
        padding-top: calc(var(--header-h) + 4rem);
        padding-bottom: clamp(2rem, 5vh, 3.5rem);
        overflow: hidden;
        isolation: isolate;
    }

    .project-hero :global(.project-hero__bg) {
        position: absolute;
        inset: 0;
        z-index: -2;
    }

    .project-hero__shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(180deg, rgb(21 18 16 / 0.5) 0%, rgb(21 18 16 / 0) 25%),
            linear-gradient(0deg, rgb(21 18 16 / 0.85) 0%, rgb(21 18 16 / 0.25) 50%, rgb(21 18 16 / 0) 75%);
    }

    .project-hero__content {
        display: grid;
        gap: 2rem;
    }

    .project-hero__back {
        justify-self: start;
        color: var(--c-sand);
    }

    .project-hero__title {
        max-width: 12ch;
    }

    .project-hero__meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem var(--gap);
        padding-top: 1.75rem;
        margin-top: 1rem;
        border-top: 1px solid var(--line);
    }

    @media (width >= 900px) {
        .project-hero__meta {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .project-hero__meta dt {
        margin-bottom: 0.4rem;
        font-size: var(--fs-xs);
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--c-sand);
    }

    .project-hero__meta dd {
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
    }

    /* Intro */
    .project-intro__grid {
        display: grid;
        gap: 2rem;
    }

    .project-intro__main {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .project-intro__text {
        max-width: 40rem;
    }

    @media (width >= 1024px) {
        .project-intro__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
        }

        .project-intro__side {
            grid-column: 1 / 4;
            padding-top: 0.9em;
        }

        .project-intro__main {
            grid-column: 4 / 13;
        }

        .project-intro__text {
            margin-left: auto;
            width: 58%;
        }
    }

    /* Gallery */
    .project-gallery__grid {
        display: grid;
        gap: clamp(1.25rem, 3vw, 2.5rem);
    }

    .project-gallery__trigger {
        display: block;
        width: 100%;
        text-align: left;
    }

    .project-gallery__trigger:focus-visible {
        outline-offset: 6px;
    }

    @media (hover: hover) {
        .project-gallery__trigger:hover :global(picture) {
            transform: scale(1.04);
        }
    }

    @media (width >= 900px) {
        .project-gallery__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
            row-gap: clamp(3rem, 7vw, 7rem);
            align-items: start;
        }

        .project-gallery__item--full {
            grid-column: 1 / -1;
        }

        .project-gallery__item--left {
            grid-column: 1 / 7;
        }

        .project-gallery__item--right {
            grid-column: 8 / 13;
            margin-top: clamp(6rem, 14vw, 14rem);
        }

        .project-gallery__item--center {
            grid-column: 3 / 11;
        }

        .project-gallery__item--narrow {
            grid-column: 1 / 5;
        }

        .project-gallery__item--wide {
            grid-column: 6 / 13;
            margin-top: clamp(4rem, 10vw, 10rem);
        }
    }

    /* Palette */
    .project-palette__head {
        display: grid;
        gap: 2rem;
        margin-bottom: clamp(3rem, 6vw, 5rem);
    }

    .project-palette__list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
        gap: var(--gap);
    }

    .swatch {
        display: grid;
        gap: 0.4rem;
    }

    .swatch__color {
        display: block;
        aspect-ratio: 3 / 4;
        margin-bottom: 1rem;
        box-shadow: inset 0 0 0 1px rgb(29 25 21 / 0.08);
    }

    .swatch__name {
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
    }

    .swatch__hex {
        font-size: var(--fs-xs);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--fg-soft);
    }

    /* Next project */
    .next-project__link {
        position: relative;
        display: flex;
        align-items: flex-end;
        min-height: 85vh;
        min-height: 85svh;
        padding-block: clamp(3rem, 8vw, 6rem);
        overflow: hidden;
        isolation: isolate;
    }

    .next-project__link :global(.next-project__bg) {
        position: absolute;
        inset: 0;
        z-index: -2;
    }

    .next-project__shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(0deg, rgb(21 18 16 / 0.8) 0%, rgb(21 18 16 / 0.3) 55%, rgb(21 18 16 / 0.15));
        transition: background-color 0.8s ease;
    }

    .next-project__content {
        display: grid;
        gap: 1.25rem;
    }

    .next-project__eyebrow {
        color: var(--c-sand);
    }

    .next-project__title {
        font-family: var(--ff-serif);
        transition: transform 1s var(--ease-out);
    }

    .next-project__meta {
        color: rgb(246 241 234 / 0.8);
    }

    @media (hover: hover) {
        .next-project__link:hover :global(picture) {
            transform: scale(1.04);
        }

        .next-project__link:hover .next-project__title {
            transform: translate3d(1.5rem, 0, 0);
        }
    }

    .next-project__link:focus-visible {
        outline-offset: -6px;
    }
</style>
