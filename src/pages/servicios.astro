---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Chapter from "../components/ui/Chapter.astro";
import Media from "../components/ui/Media.astro";
import Button from "../components/ui/Button.astro";
import Faq from "../components/ui/Faq.astro";
import { services } from "../data/studio";

const [residential, online] = services;

const modalities = [
    { name: "Sesión de resolución", detail: "Una hora por videollamada para resolver dudas concretas." },
    { name: "Pack esencial", detail: "Tres sesiones y un moodboard para transformar una estancia." },
    { name: "Proyecto completo online", detail: "Diseñamos toda la estancia o vivienda a distancia." },
];

const faqs = [
    {
        question: "¿Hacéis proyectos parciales, de una sola habitación?",
        answer: "Sí, tanto en formato presencial como online. Creemos que cambiar un solo espacio bien pensado puede transformar la experiencia de toda la casa.",
    },
    {
        question: "¿Os encargáis de contratar a la constructora?",
        answer: "Creamos el proyecto detallado y supervisamos que se ejecute fielmente. Podemos recomendarte empresas de confianza, pero la contratación se realiza directamente entre tú y la constructora, para garantizarte total transparencia en los costes.",
    },
    {
        question: "¿Cuánto dura un proyecto residencial completo?",
        answer: "La fase de diseño suele durar entre 6 y 8 semanas. La ejecución depende de la magnitud de la reforma, pero un proyecto integral oscila entre 4 y 6 meses de obra.",
    },
];
---

<BaseLayout
    title="Servicios"
    description="Interiorismo residencial integral en Madrid y consultoría de diseño online en toda España."
    image={residential.image}
>
    <PageHero
        eyebrow="Servicios"
        title="Desde la primera idea|<em>hasta el último detalle</em>"
        intro="Transformamos viviendas completas o resolvemos dudas concretas a distancia. Dos formas de trabajar, el mismo cuidado."
    />

    <section id={residential.slug} class="service section" aria-labelledby="service-1-title">
        <div class="wrap service__grid">
            <Media
                src={residential.image}
                alt="Vivienda contemporánea con grandes ventanales y madera, iluminada al anochecer"
                ratio="4 / 5"
                eager
                preset="large"
                sizes="(min-width: 1024px) 44vw, 100vw"
                reveal
                parallax={0.1}
                class="service__media"
            />
            <div class="service__body">
                <Chapter num="01" label={residential.kicker} />
                <h2 id="service-1-title" class="t-h1" data-split>Interiorismo <em>residencial</em></h2>
                <p class="t-lg t-soft" data-reveal>{residential.summary}</p>

                <h3 class="eyebrow service__subhead" data-reveal>Qué incluye</h3>
                <ol class="service__list">
                    {
                        residential.includes.map((item, i) => (
                            <li data-reveal>
                                <span class="service__num" aria-hidden="true">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                {item}
                            </li>
                        ))
                    }
                </ol>
                <div data-reveal>
                    <Button href="/contacto?servicio=interiorismo-completo" variant="solid">Hablemos de tu casa</Button>
                </div>
            </div>
        </div>
    </section>

    <section id={online.slug} class="service service--reverse section theme-linen" aria-labelledby="service-2-title">
        <div class="wrap service__grid">
            <Media
                src={online.image}
                alt="Salón sereno en tonos crema con espejos de fibra natural y butacas tapizadas"
                ratio="4 / 5"
                preset="large"
                sizes="(min-width: 1024px) 44vw, 100vw"
                reveal
                parallax={0.1}
                class="service__media"
            />
            <div class="service__body">
                <Chapter num="02" label={online.kicker} />
                <h2 id="service-2-title" class="t-h1" data-split>Consultoría <em>online</em></h2>
                <p class="t-lg t-soft" data-reveal>
                    Si no estás cerca de Madrid o prefieres gestionar tú misma las compras y la ejecución, este
                    servicio es para ti: te damos una hoja de ruta clara para conseguir el resultado que buscas.
                </p>

                <h3 class="eyebrow service__subhead" data-reveal>Modalidades</h3>
                <ul class="service__modes">
                    {
                        modalities.map((mode) => (
                            <li data-reveal>
                                <span class="service__mode-name">{mode.name}</span>
                                <span class="t-soft">{mode.detail}</span>
                            </li>
                        ))
                    }
                </ul>
                <div data-reveal>
                    <Button href="/consultoria-online" variant="solid">Descubre la consultoría</Button>
                </div>
            </div>
        </div>
    </section>

    <Faq num="03" title="Dudas <em>frecuentes</em>" items={faqs} />
</BaseLayout>

<style>
    .service__grid {
        display: grid;
        gap: 3rem;
    }

    .service__body {
        display: grid;
        gap: 1.75rem;
        align-content: start;
        justify-items: start;
    }

    @media (width >= 1024px) {
        .service__grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--gap);
            align-items: start;
        }

        .service__grid :global(.service__media) {
            grid-column: 1 / 7;
            position: sticky;
            top: calc(var(--header-h) + 2rem);
        }

        .service__body {
            grid-column: 8 / 13;
            padding-top: 2rem;
        }

        .service--reverse .service__grid :global(.service__media) {
            grid-column: 7 / 13;
            grid-row: 1;
        }

        .service--reverse .service__body {
            grid-column: 1 / 6;
            grid-row: 1;
        }
    }

    .service__subhead {
        margin-top: 1.5rem;
        color: var(--fg-soft);
    }

    .service__list,
    .service__modes {
        width: 100%;
        border-top: 1px solid var(--line);
    }

    .service__list li {
        display: flex;
        gap: 1.25rem;
        align-items: baseline;
        padding-block: 1.1rem;
        border-bottom: 1px solid var(--line);
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
        line-height: 1.25;
    }

    .service__num {
        flex: none;
        width: 2ch;
        font-family: var(--ff-sans);
        font-size: var(--fs-xs);
        letter-spacing: 0.12em;
        color: var(--accent);
    }

    .service__modes li {
        display: grid;
        gap: 0.3rem;
        padding-block: 1.25rem;
        border-bottom: 1px solid var(--line);
    }

    .service__mode-name {
        font-family: var(--ff-serif);
        font-size: var(--fs-h4);
    }

    .service__body :global(.btn) {
        margin-top: 1rem;
    }
</style>
