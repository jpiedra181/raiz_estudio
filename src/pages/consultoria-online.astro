---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Chapter from "../components/ui/Chapter.astro";
import Button from "../components/ui/Button.astro";
import { images } from "../data/studio";

const plans = [
    {
        name: "Primera consulta",
        format: "1 h de videollamada",
        description:
            "Diagnóstico y orientación. Ideal si tienes dudas concretas sobre distribución, color o qué piezas comprar.",
        price: "95 €",
        unit: "sesión",
        cta: "Reservar sesión",
    },
    {
        name: "Pack esencial",
        format: "3 sesiones + moodboard",
        description:
            "El impulso perfecto para transformar una estancia. Definimos estilo y colores y te entregamos un mapa visual para guiar tus compras.",
        price: "250 €",
        unit: "pack",
        cta: "Elegir el pack",
        featured: true,
    },
    {
        name: "Proyecto completo",
        format: "Seguimiento integral",
        description:
            "Diseñamos toda tu vivienda a distancia: planos, infografías y un listado exacto de compras listo para ejecutar.",
        price: "A medida",
        unit: "presupuesto personalizado",
        cta: "Solicitar información",
    },
];

const steps = [
    { title: "Cuestionario previo", text: "Nos cuentas qué necesitas y nos envías fotos y medidas básicas del espacio." },
    { title: "Análisis", text: "Estudiamos tus necesidades y preparamos las primeras ideas antes de vernos." },
    { title: "Sesión online", text: "Compartimos pantalla, ideas y referencias, y resolvemos tus dudas en directo." },
    { title: "Entrega del dosier", text: "Recibes el resumen o el proyecto completo, listo para ejecutar a tu ritmo." },
];
---

<BaseLayout
    title="Consultoría online"
    description="Consultoría de interiorismo online: sesiones por videollamada, moodboards y proyectos completos a distancia en toda España."
    image={images.consultingHero}
    headerTheme="light"
>
    <PageHero
        variant="image"
        eyebrow="Consultoría online · Toda España"
        title="Diseño profesional,|<em>desde donde estés</em>"
        intro="La distancia no es un obstáculo para vivir en un espacio pensado para ti. Elige la modalidad que mejor se adapta a tu momento."
        image={images.consultingHero}
        imageAlt="Salón luminoso en tonos crema con espejos de fibra natural"
        position="50% 55%"
    />

    <section class="plans section" aria-labelledby="plans-title">
        <div class="wrap">
            <header class="plans__head">
                <Chapter num="01" label="Modalidades" />
                <h2 id="plans-title" class="t-h1" data-split>Elige cómo <em>empezar</em></h2>
            </header>

            <ul class="plans__grid">
                {
                    plans.map((plan) => (
                        <li class:list={["plan", plan.featured && "plan--featured theme-dark"]} data-reveal>
                            {plan.featured && <p class="plan__badge eyebrow">Más solicitado</p>}
                            <h3 class="t-h3 plan__name">{plan.name}</h3>
                            <p class="eyebrow t-accent">{plan.format}</p>
                            <p class="t-soft plan__text">{plan.description}</p>
                            <p class="plan__price">
                                <span class="plan__amount">{plan.price}</span>
                                <span class="plan__unit t-soft">/ {plan.unit}</span>
                            </p>
                            <Button
                                href="/contacto?servicio=consultoria-online"
                                variant={plan.featured ? "solid" : "outline"}
                                class="plan__cta"
                            >
                                {plan.cta}
                            </Button>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="how section theme-linen" aria-labelledby="how-title">
        <div class="wrap">
            <header class="how__head">
                <Chapter num="02" label="Cómo funciona" />
                <h2 id="how-title" class="t-h1" data-split>Cuatro pasos, <em>sin moverte de casa</em></h2>
            </header>
            <ol class="how__steps">
                {
                    steps.map((step, i) => (
                        <li class="how__step">
                            <span class="how__rule" data-draw aria-hidden="true" />
                            <span class="how__num" aria-hidden="true" data-reveal>
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <h3 class="t-h4" data-reveal>
                                {step.title}
                            </h3>
                            <p class="t-soft" data-reveal>
                                {step.text}
                            </p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>
</BaseLayout>

<style>
    .plans__head,
    .how__head {
        display: grid;
        gap: 2rem;
        margin-bottom: clamp(3rem, 7vw, 6rem);
    }

    .plans__grid {
        display: grid;
        gap: var(--gap);
    }

    @media (width >= 1024px) {
        .plans__grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: stretch;
        }
    }

    .plan {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: clamp(2rem, 3.5vw, 3rem);
        border: 1px solid var(--line-strong);
    }

    .plan--featured {
        border-color: var(--c-night);
    }

    @media (width >= 1024px) {
        .plan--featured {
            margin-block: -1.5rem;
            padding-block: calc(clamp(2rem, 3.5vw, 3rem) + 1.5rem);
        }
    }

    .plan__badge {
        position: absolute;
        top: 0;
        right: clamp(2rem, 3.5vw, 3rem);
        translate: 0 -50%;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        background-color: var(--c-sand);
        color: var(--c-night);
    }

    .plan__text {
        flex: 1;
    }

    .plan__price {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
        padding-top: 1.5rem;
        margin-top: 0.5rem;
        border-top: 1px solid var(--line);
    }

    .plan__amount {
        font-family: var(--ff-serif);
        font-size: clamp(2.5rem, 1.8rem + 2.4vw, 3.75rem);
        font-weight: 300;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .plan__unit {
        font-size: var(--fs-sm);
    }

    .plan :global(.plan__cta) {
        margin-top: 1rem;
        width: 100%;
    }

    .how__steps {
        display: grid;
        gap: 3rem var(--gap);
    }

    @media (width >= 640px) {
        .how__steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (width >= 1024px) {
        .how__steps {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .how__step {
        position: relative;
        display: grid;
        align-content: start;
        gap: 0.9rem;
        padding-top: 1.5rem;
    }

    .how__rule {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background-color: var(--fg);
        opacity: 0.35;
    }

    .how__num {
        font-family: var(--ff-serif);
        font-size: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
        font-style: italic;
        font-weight: 300;
        line-height: 0.9;
        color: var(--accent);
        margin-bottom: 1rem;
    }
</style>
