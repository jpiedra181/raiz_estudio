---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import type { Project } from "../data/projects";
import CTABanner from "../components/shared/CTABanner.astro";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
    title={`${project.name} | Portfolio`}
    description={project.description[0]}
>
    <Navbar />

    <main class="project-view">
        <slot />

        <CTABanner
            title="¿Te imaginas tu casa así?"
            description="Si sientes que ha llegado el momento de darle a tu hogar el cambio que necesita, cuéntanos tu idea. Nos encantaría escucharla."
            buttonText="Hablemos"
            buttonUrl="/contacto"
        />
    </main>

    <Footer />
</BaseLayout>

<style>
    .project-view {
        padding-top: 0; /* Hero is fullscreen usually */
    }
</style>
